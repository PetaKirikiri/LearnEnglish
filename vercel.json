{
  "rewrites": [
    { "source": "/hotel", "destination": "/index.html" },
    { "source": "/hotel/:path*", "destination": "/index.html" },
    {
      "source": "/translator",
      "destination": "/translator/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/translator/*.ts": {
      "maxDuration": 240
    }
  }
}
