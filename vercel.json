{
  "rewrites": [
    {
      "source": "/success",
      "destination": "/index.html"
    },
    {
      "source": "/success/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/english",
      "destination": "/index.html"
    },
    {
      "source": "/english/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/padel-coach",
      "destination": "/index.html"
    },
    {
      "source": "/padel-coach/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/padel",
      "destination": "/index.html"
    },
    {
      "source": "/padel/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/hotel",
      "destination": "/index.html"
    },
    {
      "source": "/hotel/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/translator",
      "destination": "/translator/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/translator/*.ts": {
      "maxDuration": 240
    },
    "api/city/*.js": {
      "maxDuration": 30
    },
    "api/sentence-audio.js": {
      "maxDuration": 120,
      "includeFiles": "{node_modules/kokoro-js/voices/af_heart.bin,api/kokoro-models/**}",
      "excludeFiles": "{node_modules/onnxruntime-node/bin/napi-v3/{darwin,win32}/**,node_modules/onnxruntime-node/bin/napi-v3/linux/arm64/**,node_modules/**/*.map,node_modules/onnxruntime-web/dist/*.wasm}"
    },
    "api/classroom-next.js": {
      "maxDuration": 60
    }
  }
}
