VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SubtitleDisplay: public read-only language connection, NOT the Padel auth client.
VITE_LANGUAGE_SUPABASE_URL=
VITE_LANGUAGE_SUPABASE_ANON_KEY=

# Create a separate FIFA English LIFF app inside the existing LINE Login channel.
# Set its endpoint URL to https://learn-english-coral.vercel.app/
VITE_LIFF_ID=

# Hotel has its own LIFF entry in LINE Login channel 2010311582.
# Endpoint: https://learn-english-coral.vercel.app/hotel
# Never use the Padel LIFF ID here.
VITE_HOTEL_LIFF_ID=
